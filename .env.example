# Appwrite Project Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Database IDs (Will be created by the init script)
VITE_APPWRITE_DATABASE_ID=budget_view_db
VITE_APPWRITE_STATES_COLLECTION_ID=states
VITE_APPWRITE_MDAS_COLLECTION_ID=mdas
VITE_APPWRITE_SECTORS_COLLECTION_ID=sectors
VITE_APPWRITE_BUDGET_BUCKET_ID=budget_files
VITE_APPWRITE_EXTRACT_FUNCTION_ID=extract_budget

# Admin Secret (REQUIRED for the initialization script only)
# DO NOT commit the .env file with this key to version control
APPWRITE_API_KEY=your_secret_api_key_here
